{
  "name": "oweme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write src tests *.ts *.js *.json *.html .github/workflows/*.yml"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.4",
    "date-fns": "4.4.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "1.1.7",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "lucide-react": "0.468.0",
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tailwindcss": "4.3.4",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "fake-indexeddb": "6.2.7",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    },
    "workbox-build": {
      "glob": "^14.0.3"
    }
  }
}
